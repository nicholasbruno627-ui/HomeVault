<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.homevault.client.auth.RegisterController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Create New Account" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField" promptText="Email" />
    <TextField fx:id="displayNameField" promptText="Display Name" />
    <PasswordField fx:id="passwordField" promptText="Password" />

	<Label fx:id="errorLabel"
       textFill="RED"
       visible="false"
       wrapText="true"/>
	
    <Button fx:id="registerButton" text="Register" onAction="#onRegisterClicked" style="-fx-padding: 8 18;"/>

    <Button text="Back to Login" onAction="#onBackToLogin" style="-fx-padding: 6 12;"/>

</VBox>
