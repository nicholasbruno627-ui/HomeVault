<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.homevault.client.dashboard.DashboardController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Top bar: title + backup + logout -->
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="HomeVault - Dashboard"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- spacer -->
            <Pane HBox.hgrow="ALWAYS"/>

            
            <Button fx:id="logoutButton" text="Logout" onAction="#onLogout"/>
        </HBox>

        <!-- Center: table of vault items -->
        <TableView fx:id="vaultTable" prefHeight="400.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="260.0"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="260.0"/>
                <TableColumn fx:id="secretColumn" text="Secret" prefWidth="260.0"/>
            </columns>
        </TableView>

        <!-- Bottom: add / edit / delete buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="addButton" text="Add" onAction="#onAddItem"/>
            <Button fx:id="editButton" text="Edit" onAction="#onEditItem"/>
            <Button fx:id="deleteButton" text="Delete" onAction="#onDeleteItem"/>
        </HBox>
    </children>

</VBox>
