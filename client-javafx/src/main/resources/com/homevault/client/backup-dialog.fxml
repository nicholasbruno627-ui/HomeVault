<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.homevault.client.backup.BackupController">

    <!-- Top: title -->
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Backups"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Center: table of backups -->
    <center>
        <TableView fx:id="backupTable" prefHeight="400.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="locationColumn" text="Location" prefWidth="260.0"/>
                <TableColumn fx:id="sizeColumn" text="Size (bytes)" prefWidth="140.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="160.0"/>
                <TableColumn fx:id="createdColumn" text="Created At" prefWidth="240.0"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom: action buttons -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="createBackupButton"
                    text="Create Backup"
                    onAction="#onCreateBackup"/>

            <Button fx:id="restoreButton"
                    text="Restore Selected"
                    onAction="#onRestoreBackup"/>
        </HBox>
    </bottom>

</BorderPane>
